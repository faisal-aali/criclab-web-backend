MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=criclab
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# `local` uses Ollama. `production` uses Bedrock chat + Titan embeddings.
# On Vercel, APP_ENV defaults to production if this is unset.
APP_ENV=local
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-30b-a3b-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Leave these unset if you use `aws configure`, ~/.aws/credentials, or an IAM role.
# Never put these in the frontend.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Leave empty for ~/.local/share/criclab (outside the repo). Set only to override.
STORAGE_DIR=
# Must list every frontend origin that calls this API (local Vite + any deployed UI).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional default calibration (meters per pixel). Omit or leave blank for uncalibrated estimates.
# DEFAULT_METERS_PER_PIXEL=

# Cloudinary — processed overlay video + PDF are uploaded here and the secure URL is returned.
# Either set CLOUDINARY_URL alone, or the three explicit fields.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth ---
# Generate a strong value, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
# The API refuses to issue tokens without this set.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Email (OTP, password reset, notifications) ---
# For Gmail use an App Password, not the account password.
# Never commit real values — this file holds placeholders only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-address@example.com
EMAIL_FROM_NAME=CricLab
# Where links inside emails point — the frontend origin, not this API.
APP_BASE_URL=http://localhost:5173
