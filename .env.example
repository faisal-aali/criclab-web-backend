# Website API only. Video workers live in criclab-video-service
# (Mongo / Cloudinary / STORAGE_DIR must match that service).

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=criclab

# Chat assistant (not video analysis). `local` = Ollama, `production` = Bedrock.
APP_ENV=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-30b-a3b-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Production only: start this EC2 after a job is queued (same keys as Bedrock).
WORKER_EC2_INSTANCE_ID=i-0c2341cb9422fdaa0
WORKER_EC2_REGION=ap-south-1

# Max videos started per UTC day (Action + Ball-flight share one counter).
DAILY_VIDEO_QUOTA=60

# Leave empty for ~/.local/share/criclab. Must match criclab-video-service.
STORAGE_DIR=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser clip upload (signed params). Overlay/PDF upload is the video service.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Auth ---
# Generate a strong value, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
# The API refuses to issue tokens without this set.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Email (OTP, password reset, notifications) ---
# For Gmail use an App Password, not the account password.
# Never commit real values — this file holds placeholders only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@example.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-address@example.com
EMAIL_FROM_NAME=CricLab
# Where links inside emails point — the frontend origin, not this API.
APP_BASE_URL=http://localhost:5173
